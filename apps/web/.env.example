# RECON Web — Public browser settings
# Copy to .env and adjust for your environment.
# These variables are PUBLIC (exposed to the browser) and MUST NOT hold secrets.

# API mode:
#   mock  → use local JSON fixtures (no running API needed)
#   api   → proxy requests to a real FastAPI server
PUBLIC_API_MODE=mock

# Base URL of the FastAPI server (used when PUBLIC_API_MODE=api)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

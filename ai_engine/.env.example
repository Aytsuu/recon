AI_ENGINE_ENV=development
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
AI_ENGINE_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:5500,http://127.0.0.1:5500

# AssemblyAI (optional — fake streaming token service is used when unset)
AI_ENGINE_ASSEMBLYAI_API_KEY=

# LLM — Intent Agent, Context Agent, and Contact Agent (Google Gemini)
AI_ENGINE_GEMINI_API_KEY=
AI_ENGINE_GEMINI_MODEL=gemini-1.5-flash

# OpenAI (retained for future use — not wired in dependencies)
# AI_ENGINE_OPENAI_API_KEY=
# AI_ENGINE_OPENAI_MODEL=gpt-4o-mini

# Supabase (optional — for server-side integration)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
